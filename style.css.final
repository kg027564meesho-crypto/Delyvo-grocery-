* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f7f8fa;
  color: #172018;
}

.topbar {
  background: #ffffff;
  padding: 18px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #e7e7e7;
}

.topbar h1 {
  margin: 0;
  font-size: 24px;
  letter-spacing: 2px;
}

.topbar p {
  margin: 4px 0 0;
  color: #707070;
  font-size: 13px;
}

#cartBtn {
  border: 0;
  background: #111;
  color: white;
  border-radius: 12px;
  padding: 11px 14px;
  font-size: 17px;
}

.location {
  margin: 16px;
  padding: 14px;
  background: white;
  border-radius: 14px;
  display: flex;
  gap: 12px;
  align-items: center;
}

.location small,
.location strong {
  display: block;
}

.location small {
  color: #777;
  margin-bottom: 3px;
}

.search {
  padding: 0 16px 16px;
}

.search input {
  width: 100%;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 14px;
  font-size: 15px;
  outline: none;
}

main section:not(.location):not(.search) {
  padding: 0 16px 20px;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title h2 {
  font-size: 19px;
  margin: 8px 0 14px;
}

.categories {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.category {
  background: white;
  border-radius: 14px;
  padding: 18px 12px;
  text-align: center;
  border: 1px solid #eee;
}

.category .icon {
  font-size: 30px;
}

.category h3 {
  margin: 8px 0 0;
  font-size: 14px;
}

.products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.product {
  background: white;
  border-radius: 14px;
  padding: 12px;
  border: 1px solid #eee;
}

.product-image {
  height: 110px;
  background: #f0f1f2;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
}

.product h3 {
  font-size: 14px;
  margin: 10px 0 4px;
}

.product .price {
  font-weight: bold;
}

.add-btn {
  width: 100%;
  margin-top: 9px;
  padding: 9px;
  border: 0;
  border-radius: 9px;
  background: #111;
  color: white;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 10px;
}

.product .unit {
  color: #777;
  font-size: 12px;
  margin-bottom: 5px;
}

.product .price {
  font-size: 16px;
}

.product .mrp {
  color: #999;
  text-decoration: line-through;
  font-size: 12px;
  font-weight: normal;
  margin-left: 5px;
}

.add-btn {
  cursor: pointer;
  font-weight: 600;
}

.add-btn:active {
  transform: scale(0.98);
}


.drawer {
  position: fixed;
  right: -430px;
  top: 0;
  width: min(430px,100%);
  height: 100%;
  background: white;
  z-index: 50;
  box-shadow: -8px 0 30px rgba(0,0,0,.2);
  transition: .25s;
  display: flex;
  flex-direction: column;
}

.drawer.open {
  right: 0;
}

.drawer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px;
  border-bottom: 1px solid #eee;
}

.drawer-head h2 {
  margin: 0;
}

.close-btn {
  border: 0;
  background: #eee;
  border-radius: 50%;
  width: 34px;
  height: 34px;
  font-size: 22px;
}

.cart-items {
  padding: 15px;
  overflow-y: auto;
  flex: 1;
}

.cart-row {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.cart-row-info {
  flex: 1;
}

.qty {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.qty button {
  width: 28px;
  height: 28px;
  border: 1px solid #ddd;
  background: white;
  border-radius: 7px;
}

.cart-footer {
  padding: 16px;
  border-top: 1px solid #eee;
}

.cart-footer > div {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
}

.cart-total {
  font-size: 19px;
  padding: 12px 0 !important;
}

.primary-btn {
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 12px;
  background: #111;
  color: white;
  font-weight: bold;
  font-size: 15px;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  z-index: 60;
  display: none;
  align-items: flex-end;
}

.modal.open {
  display: flex;
}

.modal-card {
  width: min(520px,100%);
  background: white;
  border-radius: 20px 20px 0 0;
  padding-bottom: 20px;
}

.modal-card form {
  padding: 16px;
}

.modal-card input,
.modal-card textarea {
  width: 100%;
  padding: 13px;
  margin-bottom: 10px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font: inherit;
}

.modal-card textarea {
  min-height: 80px;
}

.checkout-summary,
.payment-box {
  margin: 16px;
  padding: 14px;
  border: 1px solid #eee;
  border-radius: 12px;
}

.checkout-line {
  display: flex;
  justify-content: space-between;
  padding: 7px 0;
}
