<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delyvo Grocery</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header class="topbar">
    <div>
      <h1>DELYVO</h1>
      <p>Fresh groceries, delivered.</p>
    </div>

    <div class="header-actions">
      <button id="myOrdersBtn" class="secondary-btn">My Orders</button>
  <button id="loginBtn" class="secondary-btn">Login</button>
      <button id="cartBtn">
        🛒 <span id="cartCount">0</span>
      </button>
    </div>
  </header>

  
<div id="authModal" class="modal">
  <div class="modal-card">
    <div class="drawer-head">
      <h2 id="authTitle">Delyvo Login</h2>
      <button class="close-btn" onclick="closePanel('authModal')">×</button>
    </div>

    <form id="authForm">
      <input id="authEmail" type="email" placeholder="Email" required>
      <input id="authPassword" type="password" placeholder="Password" required>
      <button class="primary-btn" type="submit">Login</button>
    </form>

    <p id="authMessage"></p>

    <button id="signupBtn" class="secondary-btn" type="button">
      New customer? Create account
    </button>
  </div>
</div>

<main>
    <section id="locationBtn" class="location">
      <span>📍</span>
      <div>
        <small>Deliver to</small>
        <strong id="locationText">Select your location</strong>
      </div>
    </section>

    <section class="search">
      <input
        id="searchInput"
        type="search"
        placeholder="Search groceries..."
      >
    </section>

    <section>
      <div class="section-title">
        <h2>Categories</h2>
      </div>

      <div id="categories" class="categories">
        <p>Loading categories...</p>
      </div>
    </section>

    <section>
      <div class="section-title">
        <h2>Popular products</h2>
      </div>

      <div id="products" class="products">
        <p>Loading products...</p>
      </div>
    </section>
  </main>

  
<div id="cartPanel" class="drawer">
  <div class="drawer-head">
    <h2>Your Cart</h2>
    <button class="close-btn" onclick="closePanel('cartPanel')">×</button>
  </div>
  <div id="cartItems" class="cart-items"></div>
  <div class="cart-footer">
    <div><span>Subtotal</span><b id="cartSubtotal">₹0</b></div>
    <div><span>Delivery</span><b>FREE</b></div>
    <div class="cart-total"><span>Total</span><b id="cartTotal">₹0</b></div>
    <button class="primary-btn" onclick="openCheckout()">Proceed to Checkout</button>
  </div>
</div>

<div id="locationModal" class="modal">
  <div class="modal-card">
    <div class="drawer-head">
      <h2>Delivery Address</h2>
      <button class="close-btn" onclick="closePanel('locationModal')">×</button>
    </div>

    <form id="addressForm">
      <input name="label" placeholder="Home / Work" required>
      <input name="recipient_name" placeholder="Your name" required>
      <input name="phone" placeholder="Phone number" required>
      <textarea name="address_line1" placeholder="House / street / area" required></textarea>
      <input name="city" placeholder="City" required>
      <input name="pincode" placeholder="Pincode" required>
      <button class="primary-btn" type="submit">Save Address</button>
    </form>
  </div>
</div>

<div id="checkoutModal" class="modal">
  <div class="modal-card">
    <div class="drawer-head">
      <h2>Checkout</h2>
      <button class="close-btn" onclick="closePanel('checkoutModal')">×</button>
    </div>

    <div id="checkoutSummary" class="checkout-summary"></div>

    <div class="payment-box">
      <b>Payment Method</b>
      <p>Cash on Delivery</p>
    </div>

    <button class="primary-btn" onclick="placeOrder()">Place Order</button>
  </div>
</div>

<script src="app.js"></script>

<script>
(() => {
  function showDelyvoOrderSuccess(order) {
    let old = document.getElementById("delyvoOrderSuccess");
    if (old) old.remove();

    const modal = document.createElement("div");
    modal.id = "delyvoOrderSuccess";

    modal.innerHTML = `
      <div class="dos-backdrop"></div>

      <div class="dos-card">
        <div class="dos-check">✓</div>

        <h2>Order Placed Successfully</h2>

        <p class="dos-thanks">
          Thank you for shopping with Delyvo.
        </p>

        <div class="dos-order">
          <span>Order Number</span>
          <strong>${escapeHtml(order.order_number || "")}</strong>
        </div>

        <div class="dos-row">
          <span>Subtotal</span>
          <strong>₹${Number(order.subtotal || 0).toFixed(0)}</strong>
        </div>

        <div class="dos-row">
          <span>Delivery Fee</span>
          <strong>₹${Number(order.delivery_fee || 0).toFixed(0)}</strong>
        </div>

        <div class="dos-total">
          <span>Total</span>
          <strong>₹${Number(order.total || 0).toFixed(0)}</strong>
        </div>

        <div class="dos-cod">
          💵 Cash on Delivery
        </div>

        <button class="dos-primary" id="dosContinue">
          Continue Shopping
        </button>

        <button class="dos-secondary" id="dosOrders">
          My Orders
        </button>
      </div>
    `;

    document.body.appendChild(modal);

    document.getElementById("dosContinue").onclick = () => {
      modal.remove();
      window.scrollTo({top: 0, behavior: "smooth"});
    };

    document.getElementById("dosOrders").onclick = () => {
      modal.remove();

      if (typeof window.openMyOrders === "function") {
        window.openMyOrders();
      } else {
        alert("My Orders section next update mein available hoga.");
      }
    };
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  window.showDelyvoOrderSuccess = showDelyvoOrderSuccess;

  const style = document.createElement("style");

  style.textContent = `
    #delyvoOrderSuccess {
      position:fixed;
      inset:0;
      z-index:99999;
    }

    .dos-backdrop {
      position:absolute;
      inset:0;
      background:rgba(0,0,0,.55);
    }

    .dos-card {
      position:relative;
      z-index:2;
      width:min(92%,430px);
      box-sizing:border-box;
      margin:8vh auto 0;
      padding:28px;
      background:#fff;
      border-radius:22px;
      box-shadow:0 15px 50px rgba(0,0,0,.25);
      text-align:center;
    }

    .dos-check {
      width:68px;
      height:68px;
      margin:0 auto 15px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#dff7e4;
      color:#11852e;
      font-size:38px;
      font-weight:800;
    }

    .dos-card h2 {
      margin:0;
      font-size:24px;
    }

    .dos-thanks {
      color:#777;
      margin:8px 0 22px;
    }

    .dos-order {
      padding:14px;
      border-radius:12px;
      background:#f7f7f7;
      margin-bottom:15px;
    }

    .dos-order span {
      display:block;
      color:#777;
      font-size:13px;
      margin-bottom:5px;
    }

    .dos-order strong {
      font-size:19px;
    }

    .dos-row,
    .dos-total {
      display:flex;
      justify-content:space-between;
      gap:15px;
      padding:8px 0;
    }

    .dos-row {
      color:#666;
    }

    .dos-total {
      margin-top:8px;
      padding-top:14px;
      border-top:1px solid #eee;
      font-size:18px;
    }

    .dos-cod {
      margin:18px 0;
      padding:12px;
      border-radius:10px;
      background:#fff7df;
      color:#7b5a00;
      font-weight:700;
    }

    .dos-primary,
    .dos-secondary {
      width:100%;
      padding:12px;
      border-radius:10px;
      cursor:pointer;
      font-size:15px;
    }

    .dos-primary {
      border:0;
      background:#111;
      color:#fff;
    }

    .dos-secondary {
      margin-top:9px;
      border:1px solid #ddd;
      background:#fff;
      color:#222;
    }
  `;

  document.head.appendChild(style);
})();
</script>


<script>
(() => {
  const SUPABASE_URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const SUPABASE_KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  function customerToken() {
    return localStorage.getItem("delyvo_access_token") || "";
  }

  async function customerApi(path) {
    const token = customerToken();

    if (!token) {
      throw new Error("Please login first.");
    }

    const response = await fetch(
      SUPABASE_URL + path,
      {
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: "Bearer " + token
        }
      }
    );

    const data = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        data?.message ||
        data?.msg ||
        "Unable to load orders"
      );
    }

    return data;
  }

  function orderStatusLabel(status) {
    const labels = {
      placed: "ORDER RECEIVED",
      pending: "ORDER RECEIVED",
      confirmed: "CONFIRMED",
      packing: "PACKING",
      packed: "READY",
      out_for_delivery: "OUT FOR DELIVERY",
      delivered: "DELIVERED",
      cancelled: "CANCELLED",
      refunded: "REFUNDED"
    };

    return labels[status] ||
      String(status || "").replaceAll("_", " ").toUpperCase();
  }

  function openMyOrders() {
    let old = document.getElementById("delyvoMyOrders");
    if (old) old.remove();

    const modal = document.createElement("div");
    modal.id = "delyvoMyOrders";

    modal.innerHTML = `
      <div class="mo-backdrop"></div>

      <div class="mo-card">
        <div class="mo-head">
          <div>
            <h2>My Orders</h2>
            <p>Your Delyvo grocery orders</p>
          </div>

          <button class="mo-close" id="moClose">×</button>
        </div>

        <div id="moOrdersList">
          <p class="mo-loading">Loading orders...</p>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    document.getElementById("moClose").onclick =
      () => modal.remove();

    loadMyOrders();
  }

  async function loadMyOrders() {
    const box = document.getElementById("moOrdersList");

    if (!box) return;

    try {
      const orders = await customerApi(
        "/rest/v1/orders" +
        "?select=id,order_number,status,payment_status,subtotal,delivery_fee,total,created_at" +
        "&order=created_at.desc"
      );

      if (!orders.length) {
        box.innerHTML = `
          <div class="mo-empty">
            <div>🛍️</div>
            <strong>No orders yet</strong>
            <p>Your orders will appear here.</p>
          </div>
        `;
        return;
      }

      box.innerHTML = "";

      orders.forEach(order => {
        const card = document.createElement("div");
        card.className = "mo-order";

        card.innerHTML = `
          <div class="mo-order-top">
            <div>
              <strong>${escapeHtml(order.order_number)}</strong>
              <small>${formatDate(order.created_at)}</small>
            </div>

            <span class="mo-status mo-${escapeHtml(order.status)}">
              ${orderStatusLabel(order.status)}
            </span>
          </div>

          <div class="mo-details">
            <div>
              <span>Subtotal</span>
              <strong>₹${Number(order.subtotal || 0).toFixed(0)}</strong>
            </div>

            <div>
              <span>Delivery</span>
              <strong>₹${Number(order.delivery_fee || 0).toFixed(0)}</strong>
            </div>

            <div>
              <span>Total</span>
              <strong>₹${Number(order.total || 0).toFixed(0)}</strong>
            </div>
          </div>

          <div class="mo-payment">
            <span>Payment: ${escapeHtml(
              order.payment_status || "pending"
            ).toUpperCase()}</span>

            <span>Cash on Delivery</span>
          </div>
        `;

        box.appendChild(card);
      });

    } catch (e) {
      box.innerHTML = `
        <div class="mo-error">
          ${escapeHtml(e.message)}
        </div>
      `;
    }
  }

  function formatDate(value) {
    try {
      return new Date(value).toLocaleString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    } catch {
      return "";
    }
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  window.openMyOrders = openMyOrders;

  const style = document.createElement("style");

  style.textContent = `
    #delyvoMyOrders {
      position:fixed;
      inset:0;
      z-index:99998;
    }

    .mo-backdrop {
      position:absolute;
      inset:0;
      background:rgba(0,0,0,.55);
    }

    .mo-card {
      position:relative;
      z-index:2;
      width:min(94%,700px);
      max-height:86vh;
      overflow:auto;
      box-sizing:border-box;
      margin:7vh auto 0;
      padding:22px;
      background:#fff;
      border-radius:20px;
      box-shadow:0 15px 50px rgba(0,0,0,.25);
    }

    .mo-head {
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:15px;
      margin-bottom:18px;
    }

    .mo-head h2 {
      margin:0;
    }

    .mo-head p {
      margin:4px 0 0;
      color:#777;
    }

    .mo-close {
      width:38px;
      height:38px;
      border:0;
      border-radius:50%;
      background:#f2f2f2;
      font-size:25px;
      cursor:pointer;
    }

    .mo-order {
      padding:16px;
      margin-bottom:12px;
      border:1px solid #eee;
      border-radius:14px;
      background:#fafafa;
    }

    .mo-order-top {
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
    }

    .mo-order-top strong,
    .mo-order-top small {
      display:block;
    }

    .mo-order-top small {
      color:#777;
      margin-top:4px;
    }

    .mo-status {
      padding:6px 9px;
      border-radius:20px;
      font-size:10px;
      font-weight:800;
      background:#eee;
    }

    .mo-placed,
    .mo-pending {
      background:#fff1c7;
      color:#8a5b00;
    }

    .mo-confirmed,
    .mo-packing,
    .mo-packed {
      background:#e7f0ff;
      color:#2457a6;
    }

    .mo-out_for_delivery,
    .mo-delivered {
      background:#d9f7df;
      color:#08752b;
    }

    .mo-cancelled,
    .mo-refunded {
      background:#ffe2e2;
      color:#a40000;
    }

    .mo-details {
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:10px;
      margin-top:15px;
    }

    .mo-details div {
      padding:10px;
      border-radius:10px;
      background:#fff;
    }

    .mo-details span {
      display:block;
      color:#777;
      font-size:12px;
      margin-bottom:4px;
    }

    .mo-payment {
      display:flex;
      justify-content:space-between;
      gap:10px;
      margin-top:12px;
      padding-top:12px;
      border-top:1px solid #eee;
      color:#666;
      font-size:13px;
    }

    .mo-loading,
    .mo-empty,
    .mo-error {
      padding:30px;
      text-align:center;
    }

    .mo-empty div {
      font-size:35px;
      margin-bottom:10px;
    }

    .mo-empty p {
      color:#777;
    }

    .mo-error {
      color:#b00020;
    }

    @media(max-width:600px) {
      .mo-card {
        width:96%;
        margin-top:3vh;
        padding:16px;
      }

      .mo-order-top {
        align-items:flex-start;
        flex-direction:column;
      }

      .mo-details {
        grid-template-columns:1fr;
      }

      .mo-payment {
        align-items:flex-start;
        flex-direction:column;
      }
    }
  `;

  document.head.appendChild(style);
})();
</script>


<script>
(() => {
  function refreshOrdersButton() {
    const btn = document.getElementById("myOrdersBtn");
    if (!btn) return;

    btn.onclick = () => {
      if (!localStorage.getItem("delyvo_access_token")) {
        if (typeof window.openLogin === "function") {
          window.openLogin();
        } else {
          alert("Please login first.");
        }
        return;
      }

      if (typeof window.openMyOrders === "function") {
        window.openMyOrders();
      }
    };
  }

  refreshOrdersButton();

  window.refreshOrdersButton = refreshOrdersButton;
})();
</script>


<script>
(() => {
  const DLV_URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const DLV_KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  async function orderApi(path) {
    const token = localStorage.getItem("delyvo_access_token");

    if (!token) {
      throw new Error("Please login first.");
    }

    const response = await fetch(DLV_URL + path, {
      headers: {
        apikey: DLV_KEY,
        Authorization: "Bearer " + token
      }
    });

    const data = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        data?.message ||
        data?.msg ||
        "Unable to load order"
      );
    }

    return data;
  }

  function statusText(status) {
    const map = {
      placed: "Order Received",
      pending: "Order Received",
      confirmed: "Order Confirmed",
      packing: "Packing",
      packed: "Ready",
      out_for_delivery: "Out for Delivery",
      delivered: "Delivered",
      cancelled: "Cancelled",
      refunded: "Refunded"
    };

    return map[status] || status;
  }

  function statusStep(status) {
    if (status === "placed" || status === "pending") return 1;
    if (status === "confirmed") return 2;
    if (status === "packing") return 3;
    if (status === "packed") return 4;
    if (status === "out_for_delivery") return 5;
    if (status === "delivered") return 6;
    return 0;
  }

  async function openOrderDetails(orderId) {
    let old = document.getElementById("delyvoOrderDetails");
    if (old) old.remove();

    const modal = document.createElement("div");
    modal.id = "delyvoOrderDetails";

    modal.innerHTML = `
      <div class="od-backdrop"></div>

      <div class="od-card">
        <div class="od-head">
          <div>
            <h2>Order Details</h2>
            <p id="odOrderNumber">Loading...</p>
          </div>

          <button class="od-close">×</button>
        </div>

        <div id="odContent">
          <div class="od-loading">Loading order...</div>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    modal.querySelector(".od-close").onclick =
      () => modal.remove();

    try {
      const orders = await orderApi(
        "/rest/v1/orders" +
        "?select=id,order_number,status,payment_status,subtotal,delivery_fee,total,created_at,delivered_at,address_id" +
        "&id=eq." + encodeURIComponent(orderId) +
        "&limit=1"
      );

      if (!orders.length) {
        throw new Error("Order not found.");
      }

      const order = orders[0];

      const items = await orderApi(
        "/rest/v1/order_items" +
        "?select=id,product_name,variant_name,quantity,unit_price,total" +
        "&order_id=eq." + encodeURIComponent(orderId) +
        "&order=id"
      );

      document.getElementById("odOrderNumber").textContent =
        order.order_number;

      const current = statusStep(order.status);

      const steps = [
        ["Order Received", 1],
        ["Confirmed", 2],
        ["Packing", 3],
        ["Ready", 4],
        ["Out for Delivery", 5],
        ["Delivered", 6]
      ];

      let timeline = "";

      steps.forEach(([label, step]) => {
        let cls = "";

        if (step < current) cls = "done";
        if (step === current) cls = "active";

        timeline += `
          <div class="od-step ${cls}">
            <div class="od-dot">${step < current ? "✓" : step}</div>
            <span>${label}</span>
          </div>
        `;
      });

      let itemHtml = "";

      items.forEach(item => {
        itemHtml += `
          <div class="od-item">
            <div>
              <strong>${escapeHtml(item.product_name)}</strong>
              ${
                item.variant_name
                ? `<small>${escapeHtml(item.variant_name)}</small>`
                : ""
              }
              <span>Qty: ${Number(item.quantity || 0)}</span>
            </div>

            <strong>
              ₹${Number(item.total || 0).toFixed(0)}
            </strong>
          </div>
        `;
      });

      if (!itemHtml) {
        itemHtml = `<p class="od-muted">No item details available.</p>`;
      }

      document.getElementById("odContent").innerHTML = `
        <div class="od-current">
          <span>Current Status</span>
          <strong>${escapeHtml(statusText(order.status))}</strong>
        </div>

        <div class="od-timeline">
          ${timeline}
        </div>

        <div class="od-section">
          <h3>Items</h3>
          ${itemHtml}
        </div>

        <div class="od-section">
          <h3>Bill Details</h3>

          <div class="od-row">
            <span>Subtotal</span>
            <strong>₹${Number(order.subtotal || 0).toFixed(0)}</strong>
          </div>

          <div class="od-row">
            <span>Delivery Fee</span>
            <strong>₹${Number(order.delivery_fee || 0).toFixed(0)}</strong>
          </div>

          <div class="od-total">
            <span>Total</span>
            <strong>₹${Number(order.total || 0).toFixed(0)}</strong>
          </div>
        </div>

        <div class="od-payment">
          💵 Cash on Delivery
          <span>${escapeHtml(
            String(order.payment_status || "pending").toUpperCase()
          )}</span>
        </div>

        <p class="od-date">
          Ordered: ${formatDate(order.created_at)}
        </p>
      `;

    } catch (error) {
      document.getElementById("odContent").innerHTML = `
        <div class="od-error">
          ${escapeHtml(error.message)}
        </div>
      `;
    }
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function formatDate(value) {
    try {
      return new Date(value).toLocaleString("en-IN", {
        day: "2-digit",
