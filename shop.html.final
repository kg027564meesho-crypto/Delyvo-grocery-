<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Delyvo Shop Panel</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f6f8;color:#171717}
header{background:#111;color:white;padding:18px 20px;display:flex;justify-content:space-between;align-items:center}
main{max-width:1100px;margin:20px auto;padding:0 15px}
.card{background:white;border-radius:12px;padding:18px;margin-bottom:15px;box-shadow:0 2px 10px #00000012}
input,button,select{padding:11px;border-radius:8px;border:1px solid #ddd;font-size:15px}
input{width:100%;margin-bottom:10px}
button{cursor:pointer}
.primary{background:#111;color:white;border:0}
.order{border:1px solid #eee;border-radius:10px;padding:15px;margin-top:12px}
.row{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.status{font-weight:bold}
.items{margin:10px 0;padding-left:18px}
.error{color:#b00020}
</style>
</head>
<body>

<header>
  <div>
    <b>DELYVO</b>
    <div>Grocery Shop Panel</div>
  </div>
  <button id="logoutBtn">Logout</button>
</header>

<main>

<div id="loginBox" class="card">
  <h2>Shop Login</h2>
  <input id="email" type="email" placeholder="Staff email">
  <input id="password" type="password" placeholder="Password">
  <button id="login" class="primary">Login</button>
  <p id="loginMsg"></p>
</div>

<div id="shopBox" style="display:none">
  <div class="card">
    <div class="row">
      <div>
        <h2 style="margin:0">Orders</h2>
        <small>Modinagar Store · 201204</small>
      </div>
      <button id="refresh" class="primary">Refresh</button>
    </div>
  </div>

  <div id="orders"></div>
</div>

</main>

<script>
const SUPABASE_URL="https://unwdkreujyejgcucgttj.supabase.co";
const SUPABASE_KEY="sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

function token(){
  return localStorage.getItem("delyvo_shop_token");
}

async function login(){
  const email=document.getElementById("email").value.trim();
  const password=document.getElementById("password").value;
  const msg=document.getElementById("loginMsg");

  msg.textContent="Login ho raha hai...";

  const r=await fetch(
    SUPABASE_URL+"/auth/v1/token?grant_type=password",
    {
      method:"POST",
      headers:{
        "Content-Type":"application/json",
        apikey:SUPABASE_KEY
      },
      body:JSON.stringify({email,password})
    }
  );

  const d=await r.json();

  if(!r.ok){
    msg.className="error";
    msg.textContent=d.msg||d.message||"Login failed";
    return;
  }

  localStorage.setItem("delyvo_shop_token",d.access_token);
  localStorage.setItem("delyvo_shop_refresh",d.refresh_token);

  await loadShop();
}

async function api(path,options={}){
  const headers={
    apikey:SUPABASE_KEY,
    Authorization:"Bearer "+token(),
    ...options.headers
  };

  return fetch(SUPABASE_URL+path,{...options,headers});
}

window.loadShopOrders = async function() {
  const tokenValue =
    localStorage.getItem("delyvo_shop_token") || "";

  if (!tokenValue) {
    document.getElementById("loginBox").style.display = "block";
    document.getElementById("shopBox").style.display = "none";
    return [];
  }

  try {
    const response = await fetch(
      SUPABASE_URL +
      "/rest/v1/orders" +
      "?select=id,order_number,status,payment_status,subtotal,delivery_fee,total,created_at,address_id," +
      "order_items(id,product_name,variant_name,quantity,unit_price,total)," +
      "addresses(recipient_name,phone,address_line1,address_line2,landmark,city,state,pincode)" +
      "&order=created_at.desc",
      {
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: "Bearer " + tokenValue
        }
      }
    );

    const data = await response.json().catch(() => []);

    if (!response.ok) {
      throw new Error(
        data?.message ||
        data?.hint ||
        data?.details ||
        "Orders load nahi ho paye."
      );
    }

    document.getElementById("loginBox").style.display = "none";
    document.getElementById("shopBox").style.display = "block";

    const orders = Array.isArray(data) ? data : [];

    window.renderFinalShopOrders(orders);

    if (typeof window.addFinalShopOrderFilters === "function") {
      window.addFinalShopOrderFilters();
    }

    if (typeof window.filterFinalShopOrders === "function") {
      window.filterFinalShopOrders();
    }

    return orders;

  } catch (error) {
    console.error("DELYVO SHOP ORDERS ERROR:", error);

    const msg = document.getElementById("loginMsg");

    if (msg) {
      msg.className = "error";
      msg.textContent =
        error?.message ||
        "Orders load nahi ho paye.";
    }

    return [];
  }
};


async function loadShop() {
  return await window.loadShopOrders();
}


document.getElementById("login").onclick=login;
document.getElementById("refresh").onclick=loadShop;

document.getElementById("logoutBtn").onclick=()=>{
  localStorage.removeItem("delyvo_shop_token");
  localStorage.removeItem("delyvo_shop_refresh");
  location.reload();
};

if(token()) loadShop();
</script>


<script>
(() => {
if(token()) loadShop();
</script>


<script>
(() => {
  const URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";
  const STORE_ID = "7ef989c8-9826-437b-8a63-bb0dfa817540";

  function token() {
    return localStorage.getItem("delyvo_shop_token") || "";
  }

  async function api(path, options = {}) {
    const headers = {
      apikey: KEY,
      Authorization: "Bearer " + token(),
  async function orderApi(path, options = {}) {
    const r = await fetch(URL + path, {
      ...options,
      headers: {
        apikey: KEY,
        Authorization: "Bearer " + shopToken(),
        "Content-Type": "application/json",
        ...(options.headers || {})
      }
    });

    const data = await r.json().catch(() => null);

    if (!r.ok) {
      throw new Error(
        data?.message ||
        data?.msg ||
        data?.error ||
        "Order request failed"
      );
    }

    return data;
  }

  function nextStatus(status) {
    const flow = {
      placed: "confirmed",
      pending: "confirmed",
      confirmed: "packing",
      packing: "packed",
      packed: "out_for_delivery",
      out_for_delivery: "delivered"
    };

    return flow[status] || null;
  }

  function statusLabel(status) {
    const labels = {
      placed: "NEW",
      pending: "NEW",
      confirmed: "CONFIRMED",
      packing: "PACKING",
      packed: "READY",
      out_for_delivery: "OUT FOR DELIVERY",
      delivered: "DELIVERED",
      cancelled: "CANCELLED"
    };

    return labels[status] || String(status || "").toUpperCase();
  }

})();
</script>


<script>
(() => {
  const DLV_SUPABASE_URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const DLV_SUPABASE_KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  function shopToken() {
    return localStorage.getItem("delyvo_shop_token") || "";
  }

  async function shopRequest(path, options = {}) {
    const response = await fetch(
      DLV_SUPABASE_URL + path,
      {
        ...options,
        headers: {
          apikey: DLV_SUPABASE_KEY,
          Authorization: "Bearer " + shopToken(),
          "Content-Type": "application/json",
          ...(options.headers || {})
        }
      }
    );

    const data = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        data?.message ||
        data?.msg ||
        data?.hint ||
        "Shop request failed"
      );
    }

    return data;
  }

  async function markShopOrderDelivered(orderId) {
    if (!orderId) return;

    if (!shopToken()) {
      alert("Shop login required.");
      return;
    }

    try {
      const deliveries = await shopRequest(
        "/rest/v1/deliveries" +
        "?select=id,status,order_id" +
        "&order_id=eq." + encodeURIComponent(orderId) +
        "&limit=1"
      );

      if (!deliveries || !deliveries.length) {
        throw new Error(
          "Delivery record nahi mila. Pehle order ko Out for Delivery karo."
        );
      }

      const delivery = deliveries[0];

      await shopRequest(
        "/rest/v1/deliveries?id=eq." +
        encodeURIComponent(delivery.id),
        {
          method: "PATCH",
          body: JSON.stringify({
            status: "delivered",
            delivered_at: new Date().toISOString(),
            updated_at: new Date().toISOString()
          })
        }
      );

      await shopRequest(
        "/rest/v1/rpc/transition_order_status",
        {
          method: "POST",
          body: JSON.stringify({
            p_order_id: orderId,
            p_new_status: "delivered"
          })
        }
      );

      alert("Order delivered successfully.");

      if (typeof window.loadShopOrders === "function") {
        await window.loadShopOrders();
      } else if (typeof window.loadOrders === "function") {
        await window.loadOrders();
      } else {
        location.reload();
      }

    } catch (error) {
      alert(error.message || "Order delivery update failed.");
    }
  }

  window.markShopOrderDelivered = markShopOrderDelivered;
})();
</script>


<script>
(() => {
  const DLV_URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const DLV_KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  function shopToken() {
    return localStorage.getItem("delyvo_shop_token") || "";
  }

  async function rejectShopOrder(orderId) {
    if (!orderId) return;

    if (!shopToken()) {
      alert("Shop login required.");
      return;
    }

    const ok = confirm(
      "Kya aap is order ko reject/cancel karna chahte ho?"
    );

    if (!ok) return;

    try {
      const response = await fetch(
        DLV_URL + "/rest/v1/rpc/transition_order_status",
        {
          method: "POST",
          headers: {
            apikey: DLV_KEY,
            Authorization: "Bearer " + shopToken(),
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            p_order_id: orderId,
            p_new_status: "cancelled"
          })
        }
      );

      const data = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(
          data?.message ||
          data?.msg ||
          data?.hint ||
          "Order reject failed"
        );
      }

      alert("Order rejected successfully.");

      if (typeof window.loadShopOrders === "function") {
        await window.loadShopOrders();
      } else if (typeof window.loadOrders === "function") {
        await window.loadOrders();
      } else {
        location.reload();
      }

    } catch (error) {
      alert(error.message || "Order reject failed.");
    }
  }

  window.rejectShopOrder = rejectShopOrder;



