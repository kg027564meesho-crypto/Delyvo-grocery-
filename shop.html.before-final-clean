        <div class="db-card">
          <span>Today's Sales</span>
          <strong>₹${salesToday.toFixed(0)}</strong>
        </div>

        <div class="db-card">
          <span>Low Stock</span>
          <strong>${lowStock}</strong>
        </div>

        <div class="db-card">
          <span>Active Products</span>
          <strong>${activeProducts}</strong>
        </div>
      `;

    } catch (e) {
      stats.innerHTML =
        "<div class='db-error'>Dashboard data load nahi hua.</div>";
    }
