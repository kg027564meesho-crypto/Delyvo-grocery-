<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Delyvo Shop Panel</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f6f8;color:#171717}
header{background:#111;color:white;padding:18px 20px;display:flex;justify-content:space-between;align-items:center}
main{max-width:1100px;margin:20px auto;padding:0 15px}
.card{background:white;border-radius:12px;padding:18px;margin-bottom:15px;box-shadow:0 2px 10px #00000012}
input,button,select{padding:11px;border-radius:8px;border:1px solid #ddd;font-size:15px}
input{width:100%;margin-bottom:10px}
button{cursor:pointer}
.primary{background:#111;color:white;border:0}
.order{border:1px solid #eee;border-radius:10px;padding:15px;margin-top:12px}
.row{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.status{font-weight:bold}
.items{margin:10px 0;padding-left:18px}
.error{color:#b00020}
</style>
</head>
<body>

<header>
  <div>
    <b>DELYVO</b>
    <div>Grocery Shop Panel</div>
  </div>
  <button id="logoutBtn">Logout</button>
</header>

<main>

<div id="loginBox" class="card">
  <h2>Shop Login</h2>
  <input id="email" type="email" placeholder="Staff email">
  <input id="password" type="password" placeholder="Password">
  <button id="login" class="primary">Login</button>
  <p id="loginMsg"></p>
</div>

<div id="shopBox" style="display:none">
  <div class="card">
    <div class="row">
      <div>
        <h2 style="margin:0">Orders</h2>
        <small>Modinagar Store · 201204</small>
      </div>
      <button id="refresh" class="primary">Refresh</button>
    </div>
  </div>

  <div id="orders"></div>
</div>

</main>

<script>
const SUPABASE_URL="https://unwdkreujyejgcucgttj.supabase.co";
const SUPABASE_KEY="sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

function token(){
  return localStorage.getItem("delyvo_shop_token");
}

async function login(){
  const email=document.getElementById("email").value.trim();
  const password=document.getElementById("password").value;
  const msg=document.getElementById("loginMsg");

  msg.textContent="Login ho raha hai...";

  const r=await fetch(
    SUPABASE_URL+"/auth/v1/token?grant_type=password",
    {
      method:"POST",
      headers:{
        "Content-Type":"application/json",
        apikey:SUPABASE_KEY
      },
      body:JSON.stringify({email,password})
    }
  );

  const d=await r.json();

  if(!r.ok){
    msg.className="error";
    msg.textContent=d.msg||d.message||"Login failed";
    return;
  }

  localStorage.setItem("delyvo_shop_token",d.access_token);
  localStorage.setItem("delyvo_shop_refresh",d.refresh_token);

  await loadShop();
}

async function api(path,options={}){
  const headers={
    apikey:SUPABASE_KEY,
    Authorization:"Bearer "+token(),
    ...options.headers
  };

  return fetch(SUPABASE_URL+path,{...options,headers});
}

async function loadShop(){
  const r=await api(
    "/rest/v1/orders?select=id,order_number,status,payment_status,subtotal,delivery_fee,total,created_at,address_id,order_items(id,product_name,quantity,unit_price,total),addresses(recipient_name,phone,address_line1,city,pincode)&order=id.desc"
  );

  if(!r.ok){
    const d=await r.json();
    document.getElementById("loginMsg").className="error";
    document.getElementById("loginMsg").textContent=
      d.message||"Shop access nahi mila. Staff account check karo.";
    return;
  }

  const orders=await r.json();

  document.getElementById("loginBox").style.display="none";
  document.getElementById("shopBox").style.display="block";

  const box=document.getElementById("orders");

  if(!orders.length){
    box.innerHTML='<div class="card">Abhi koi order nahi hai.</div>';
    return;
  }

  box.innerHTML=orders.map(o=>{
    const a=o.addresses||{};
    const items=o.order_items||[];

    const next={
      placed:"confirmed",
      pending:"confirmed",
      confirmed:"packing",
      packing:"packed",
      packed:"out_for_delivery"
    }[o.status];

    return `
      <div class="card order">
        <div class="row">
          <div>
            <h3 style="margin:0">${o.order_number}</h3>
            <div>${a.recipient_name||""} · ${a.phone||""}</div>
          </div>
          <div class="status">${o.status}</div>
        </div>

        <p>
          ${a.address_line1||""}<br>
          ${a.city||""} - ${a.pincode||""}
        </p>

        <ul class="items">
          ${items.map(i=>`
            <li>${i.product_name} × ${i.quantity} — ₹${i.total}</li>
          `).join("")}
        </ul>

        <div class="row">
          <b>Total: ₹${o.total}</b>
          <span>Payment: ${o.payment_status}</span>
        </div>

        ${
          next
          ? `<button class="primary" onclick="changeStatus('${o.id}','${next}')">
               ${next.replaceAll("_"," ").toUpperCase()}
             </button>`
          : ""
        }
      </div>
    `;
  }).join("");
}

async function changeStatus(id,status){
  if(!confirm("Order status '"+status+"' karna hai?")) return;

  const r=await api("/rest/v1/rpc/transition_order_status",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      p_order_id:id,
      p_new_status:status
    })
  });

  const d=await r.json();

  if(!r.ok){
    alert(d.message||d.error||"Status update failed");
    return;
  }

  await loadShop();
}

document.getElementById("login").onclick=login;
document.getElementById("refresh").onclick=loadShop;

document.getElementById("logoutBtn").onclick=()=>{
  localStorage.removeItem("delyvo_shop_token");
  localStorage.removeItem("delyvo_shop_refresh");
  location.reload();
};

if(token()) loadShop();
</script>


<script>
(() => {
  const URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";
  const STORE_ID = "7ef989c8-9826-437b-8a63-bb0dfa817540";

  function token() {
    return localStorage.getItem("delyvo_shop_token") || "";
  }

  async function api(path, options = {}) {
    const headers = {
      apikey: KEY,
      Authorization: "Bearer " + token(),
      "Content-Type": "application/json",
      ...(options.headers || {})
    };

    const r = await fetch(URL + path, {...options, headers});
    const data = await r.json().catch(() => null);

    if (!r.ok) {
      throw new Error(data?.message || data?.msg || "Request failed");
    }
    return data;
  }

  async function loadProducts() {
    const box = document.getElementById("delyvoProductsBox");
    if (!box) return;

    box.innerHTML = "<p>Products loading...</p>";

    try {
      const products = await api(
        "/rest/v1/products?select=id,name,slug,mrp,selling_price,is_active&order=name.asc"
      );

      const variants = await api(
        "/rest/v1/product_variants?select=id,product_id,name,mrp,selling_price,is_active&order=name.asc"
      );

      const inventory = await api(
        "/rest/v1/inventory?select=id,product_id,variant_id,stock_qty,reserved_qty,reorder_level&store_id=eq." +
        STORE_ID
      );

      const vmap = {};
      variants.forEach(v => vmap[v.product_id] = v);

      const imap = {};
      inventory.forEach(i => imap[i.variant_id] = i);

      box.innerHTML = "";

      if (!products.length) {
        box.innerHTML = "<p>No products found.</p>";
        return;
      }

      products.forEach(product => {
        const v = vmap[product.id];
        if (!v) return;

        const inv = imap[v.id] || {
          id: "",
          stock_qty: 0,
          reserved_qty: 0,
          reorder_level: 5
        };

        const row = document.createElement("div");
        row.className = "delyvo-product-row";

        row.innerHTML = `
          <div class="dp-name">
            <strong>${escapeHtml(product.name)}</strong>
            <small>${escapeHtml(v.name || "")}</small>
          </div>

          <input class="dp-input"
            type="number"
            min="0"
            step="0.01"
            value="${Number(v.mrp || 0)}"
            data-mrp>

          <input class="dp-input"
            type="number"
            min="0"
            step="0.01"
            value="${Number(v.selling_price || 0)}"
            data-price>

          <input class="dp-input"
            type="number"
            min="0"
            step="1"
            value="${Number(inv.stock_qty || 0)}"
            data-stock>

          <button class="dp-status ${v.is_active ? "active" : "inactive"}"
            data-status>
            ${v.is_active ? "ON" : "OFF"}
          </button>

          <button class="dp-save">Save</button>
        `;

        const statusButton = row.querySelector("[data-status]");
        statusButton.dataset.active = String(v.is_active);

        statusButton.onclick = () => {
          const current = statusButton.dataset.active === "true";
          const next = !current;

          statusButton.dataset.active = String(next);
          statusButton.textContent = next ? "ON" : "OFF";
          statusButton.classList.toggle("active", next);
          statusButton.classList.toggle("inactive", !next);
        };

        if (Number(inv.stock_qty || 0) <= Number(inv.reorder_level || 5)) {
          row.style.background = "#fff8e1";
          const name = row.querySelector(".dp-name");
          name.insertAdjacentHTML(
            "beforeend",
            '<small style="color:#b36b00;font-weight:700">⚠ Low stock</small>'
          );
        }

        row.querySelector(".dp-save").onclick = async () => {
          const btn = row.querySelector(".dp-save");
          const mrp = Number(row.querySelector("[data-mrp]").value);
          const price = Number(row.querySelector("[data-price]").value);
          const stock = Number(row.querySelector("[data-stock]").value);
          const activeButton = row.querySelector("[data-status]");
          const isActive = activeButton.dataset.active === "true";

          if (price < 0 || mrp < 0 || stock < 0) {
            alert("Value 0 se kam nahi ho sakti.");
            return;
          }

          btn.disabled = true;
          btn.textContent = "Saving...";

          try {
            await api(
              "/rest/v1/product_variants?id=eq." + v.id,
              {
                method: "PATCH",
                headers: {"Prefer": "return=minimal"},
                body: JSON.stringify({
                  mrp: mrp,
                  selling_price: price,
                  is_active: isActive
                })
              }
            );

            if (inv.id) {
              await api(
                "/rest/v1/inventory?id=eq." + inv.id,
                {
                  method: "PATCH",
                  headers: {"Prefer": "return=minimal"},
                  body: JSON.stringify({
                    stock_qty: stock
                  })
                }
              );
            }

            btn.textContent = "Saved ✓";
            setTimeout(() => btn.textContent = "Save", 1200);

          } catch (e) {
            alert(e.message);
            btn.textContent = "Save";
          } finally {
            btn.disabled = false;
          }
        };

        box.appendChild(row);
      });

    } catch (e) {
      box.innerHTML =
        "<p style='color:#b00020'>Products load nahi hue: " +
        escapeHtml(e.message) + "</p>";
    }
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function addPanel() {
    if (document.getElementById("delyvoProductsPanel")) return;

    const panel = document.createElement("section");
    panel.id = "delyvoProductsPanel";
    panel.innerHTML = `
      <div class="dp-head">
        <div>
          <h2>Products & Stock</h2>
          <p>Price aur stock yahin se manage karo.</p>
        </div>
        <button id="dpRefresh">Refresh</button>
      </div>

      <div class="dp-table-head">
        <span>Product</span>
        <span>MRP</span>
        <span>Selling Price</span>
        <span>Stock</span>
        <span>Status</span>
        <span>Action</span>
      </div>

      <div id="delyvoProductsBox"></div>
    `;

    document.body.appendChild(panel);

    document.getElementById("dpRefresh").onclick = loadProducts;
  }

  function addStyle() {
    const style = document.createElement("style");
    style.textContent = `
      #delyvoProductsPanel {
        margin: 24px auto;
        max-width: 1100px;
        padding: 20px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
      }

      .dp-head {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:15px;
        margin-bottom:18px;
      }

      .dp-head h2 {
        margin:0 0 5px;
      }

      .dp-head p {
        margin:0;
        color:#666;
      }

      #dpRefresh {
        border:0;
        padding:10px 16px;
        border-radius:9px;
        cursor:pointer;
        background:#111;
        color:#fff;
      }

      .dp-table-head,
      .delyvo-product-row {
        display:grid;
        grid-template-columns: 2fr 1fr 1.2fr 1fr 75px 90px;
        gap:10px;
        align-items:center;
      }

      .dp-table-head {
        padding:10px;
        font-weight:700;
        background:#f5f5f5;
        border-radius:8px;
      }

      .delyvo-product-row {
        padding:12px 10px;
        border-bottom:1px solid #eee;
      }

      .dp-name strong,
      .dp-name small {
        display:block;
      }

      .dp-name small {
        color:#777;
        margin-top:3px;
      }

      .dp-input {
        width:100%;
        box-sizing:border-box;
        padding:9px;
        border:1px solid #ddd;
        border-radius:8px;
      }

      .dp-status {
        border:0;
        border-radius:8px;
        padding:9px 8px;
        cursor:pointer;
        font-weight:700;
      }

      .dp-status.active {
        background:#d9f7df;
        color:#08752b;
      }

      .dp-status.inactive {
        background:#eee;
        color:#666;
      }

      .dp-save {
        border:0;
        border-radius:8px;
        padding:9px 12px;
        background:#111;
        color:#fff;
        cursor:pointer;
      }

      .dp-save:disabled {
        opacity:.6;
        cursor:wait;
      }

      @media(max-width:700px) {
        .dp-table-head {
          display:none;
        }

        .delyvo-product-row {
          grid-template-columns:1fr 1fr;
          padding:16px 5px;
        }

        .dp-name {
          grid-column:1 / -1;
        }
      }
    `;
    document.head.appendChild(style);
  }

  function start() {
    addStyle();
    addPanel();

    if (token()) {
      loadProducts();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
</script>


<script>
(() => {
  const URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  function shopToken() {
    return localStorage.getItem("delyvo_shop_token") || "";
