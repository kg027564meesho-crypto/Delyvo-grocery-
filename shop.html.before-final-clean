    const dashboard = document.createElement("section");
    dashboard.id = "delyvoDashboard";

    dashboard.innerHTML = `
      <div class="db-head">
        <div>
          <h1>Delyvo Grocery</h1>
          <p>Shop Dashboard</p>
        </div>

        <button id="dbRefresh">Refresh Dashboard</button>
      </div>

      <div id="delyvoDashboardStats" class="db-grid">
        <div class="db-loading">Loading dashboard...</div>
      </div>
    `;

    document.body.insertBefore(
      dashboard,
      document.body.firstChild
    );

    document.getElementById("dbRefresh").onclick =
      loadDashboardStats;
  }

  function addDashboardStyle() {
    const style = document.createElement("style");

    style.textContent = `
      #delyvoDashboard {
        max-width:1100px;
        margin:20px auto 0;
        padding:20px;
        background:#fff;
        border-radius:18px;
        box-shadow:0 4px 22px rgba(0,0,0,.08);
      }

      .db-head {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:20px;
        margin-bottom:20px;
      }

      .db-head h1 {
        margin:0;
        font-size:26px;
      }

      .db-head p {
        margin:4px 0 0;
        color:#777;
      }

      #dbRefresh {
        border:0;
        padding:11px 16px;
        border-radius:9px;
        background:#111;
        color:#fff;
        cursor:pointer;
      }

      .db-grid {
        display:grid;
        grid-template-columns:
          repeat(4, minmax(0, 1fr));
        gap:12px;
      }

      .db-card {
        min-height:95px;
        padding:16px;
        border:1px solid #eee;
        border-radius:14px;
        background:#fafafa;
        box-sizing:border-box;
      }

      .db-card span {
        display:block;
        color:#666;
        font-size:13px;
        margin-bottom:9px;
      }

      .db-card strong {
        font-size:25px;
      }

      .db-loading,
      .db-error {
        padding:20px;
        color:#777;
      }

      .db-error {
        color:#b00020;
      }

      @media(max-width:850px) {
        .db-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }
      }

      @media(max-width:520px) {
        #delyvoDashboard {
          margin:10px;
          padding:14px;
        }

        .db-head {
          align-items:flex-start;
          flex-direction:column;
        }

        .db-grid {
          grid-template-columns:1fr;
        }

        #dbRefresh {
          width:100%;
        }
      }
    `;

    document.head.appendChild(style);
  }

  function startDashboard() {
    addDashboardStyle();
    addDashboard();
    loadDashboardStats();
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      startDashboard
    );
  } else {
    startDashboard();
  }
})();
</script>


<script>
(() => {
  const URL = "https://unwdkreujyejgcucgttj.supabase.co";
  const KEY = "sb_publishable_QylVZHuaIj98axBkNuvbFA_Z6NX-9Q6";

  function shopToken() {
    return localStorage.getItem("delyvo_shop_token") || "";
  }

  async function orderApi(path, options = {}) {
    const r = await fetch(URL + path, {
      ...options,
      headers: {
        apikey: KEY,
        Authorization: "Bearer " + shopToken(),
        "Content-Type": "application/json",
        ...(options.headers || {})
      }
    });

    const data = await r.json().catch(() => null);

    if (!r.ok) {
      throw new Error(
        data?.message ||
        data?.msg ||
        data?.error ||
        "Order request failed"
      );
    }

    return data;
  }

  function nextStatus(status) {
    const flow = {
      placed: "confirmed",
      pending: "confirmed",
      confirmed: "packing",
      packing: "packed",
      packed: "out_for_delivery",
      out_for_delivery: "delivered"
    };

    return flow[status] || null;
  }

  function statusLabel(status) {
    const labels = {
      placed: "NEW",
      pending: "NEW",
      confirmed: "CONFIRMED",
      packing: "PACKING",
      packed: "READY",
      out_for_delivery: "OUT FOR DELIVERY",
      delivered: "DELIVERED",
      cancelled: "CANCELLED"
    };

    return labels[status] || String(status || "").toUpperCase();
  }

  async function changeOrderStatus(orderId, status, button) {
    button.disabled = true;
    button.textContent = "Saving...";

    try {
      await orderApi(
        "/rest/v1/rpc/transition_order_status",
        {
          method: "POST",
          body: JSON.stringify({
            p_order_id: orderId,
            p_new_status: status
          })
        }
      );

      button.textContent = "Saved ✓";

      setTimeout(() => {
        loadShopOrders();
      }, 500);

    } catch (e) {
      alert(e.message);
